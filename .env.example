# Copy this file to .env and fill in machine-local values. .env is gitignored --
# each machine (or each dev) keeps its own, never committed.

# Root directory that will contain <dataset_name>/<source> (e.g. PlantVillage/color).
# Leave unset to fall back to configs/config.yaml's default (~/plant_disease_dataset).
# DATA_ROOT=C:\path\to\plant_dataset

# Force environment detection instead of auto-detecting local vs Colab.
# RUN_ENV=local
